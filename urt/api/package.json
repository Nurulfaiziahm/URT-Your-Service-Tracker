{
  "name": "express-backend-template",
  "version": "1.0.0",
  "description": "A template for building an Express.js backend with TypeScript, MongoDB, and Redis.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "seed:packages": "node --import tsx src/seeds/packages.seed.ts",
    "build": "tsc && node scripts/copy-templates.js",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "clean": "node scripts/clean.js",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/auth.test.js .test-build/tests/config.test.js",
    "test:browser": "tsc -p tsconfig.test.json && node --test .test-build/tests/browser.test.js",
    "test:service-requests": "node --test tests/service-requests.test.mjs",
    "test:auth-portals": "node --test tests/auth-portals.test.mjs",
    "test:password-recovery": "node --test tests/password-recovery.test.mjs"
  },
  "keywords": [
    "express",
    "typescript",
    "mongodb",
    "redis",
    "template",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "bcryptjs": "^2.4.3",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "google-auth-library": "^10.9.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "ua-parser-js": "^2.0.8",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-session": "^1.18.2",
    "@types/handlebars": "^4.0.40",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.5",
    "@types/ua-parser-js": "^0.7.39",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
