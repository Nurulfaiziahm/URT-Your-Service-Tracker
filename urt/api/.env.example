PORT=5000
NODE_ENV=development
APP_ID=urt
# For the assignment demo, the API connects to the 'urt_demo' database within this URI.
# Set to your local MongoDB instance; the database name is applied in code.
MONGO_URI=mongodb://localhost:27017
REDIS_URI=redis://localhost:6379
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional Google Identity Services web client ID. Leave blank to disable Google auth.
GOOGLE_CLIENT_ID=
# Cloudflare R2: set all four values to enable uploads. Keep the bucket private.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# false for direct connections; a comma-separated list of trusted proxy IPs/CIDRs otherwise.
TRUST_PROXY=false
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
AUTH_NAMESPACE=v2
CSRF_NAMESPACE=v2

# Generate THREE DIFFERENT secrets using: openssl rand -hex 32
# Replace placeholders before starting. First key signs; retained entries verify.
# activatedAt, lastIssuedAt and acceptUntil are Unix seconds.
ACCESS_KEYS='[{"id":"access-1","secret":"REPLACE_ACCESS_SECRET","activatedAt":1}]'
REFRESH_KEYS='[{"id":"refresh-1","secret":"REPLACE_REFRESH_SECRET","activatedAt":1}]'
SESSION_KEYS='[{"id":"csrf-1","secret":"REPLACE_SESSION_SECRET","activatedAt":1}]'
JWT_SIGNING_VERSION=v1
JWT_SIGNING_VERSIONS='[{"id":"v1","issuer":"urt","audience":"urt-web"}]'
ACCESS_TTL=900
REFRESH_TTL=2592000
SESSION_TTL=7776000
CSRF_TTL=86400
REFRESH_GRACE=10
CLOCK_SKEW=5
KEY_ROTATION_DAYS=90

# Optional email provider. Enable to deliver verification and password-reset emails.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_FROM=
SMTP_PASS=
# Manual subscription checkout is disabled until real payment instructions are set.
SUBSCRIPTION_PAYMENT_INSTRUCTIONS=Untuk mengaktifkan langganan Anda, silakan transfer sejumlah tagihan ke salah satu rekening berikut:\n\n🏦 Transfer Bank:\n• BCA: 1234567890 a/n URT Demo Indonesia\n• Mandiri: 9876543210 a/n URT Demo Indonesia\n• BNI: 1122334455 a/n URT Demo Indonesia\n\n💸 Dompet Digital:\n• GoPay / OVO / DANA: 0812-3456-7890 (URT Demo)\n\nGunakan nomor referensi pembayaran Anda sebagai berita transfer. Pembayaran akan dikonfirmasi dalam 1x24 jam kerja. Hubungi kami di support@urt-demo.id untuk bantuan lebih lanjut.
